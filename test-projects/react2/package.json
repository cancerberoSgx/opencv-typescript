{
  "name": "react2",
  "private": true,
  "version": "0.0.0",
  "description": "Vite + React + TypeScript playground: a Monaco-editor code playground (typecheck + autocomplete against opencv-ts) running a gallery of OpenCV.js examples ported from mirada-ts-playground, adapted to opencv-ts's current typings.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
